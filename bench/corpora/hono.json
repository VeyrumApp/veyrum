{
  "name": "hono",
  "repo": "https://github.com/honojs/hono.git",
  "branch": "main",
  "commits": 40,
  "install": [
    "bash",
    "-c",
    "if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile --prefer-offline; else npx -y bun@1 install --frozen-lockfile; fi"
  ],
  "lockfiles": ["pnpm-lock.yaml", "bun.lock"],
  "runnerArgs": [
    "--project",
    "main",
    "--project",
    "jsx-runtime-default",
    "--project",
    "jsx-runtime-dom",
    "--project",
    "node"
  ],
  "maxWorkers": 2,
  "mutationSources": ["^src/(?!.*\\.test\\.)(?!.*/types\\.ts$)(?!.*\\.d\\.ts$).+\\.ts$"],
  "mutantsPerCommit": 6,
  "mutationEvery": 4
}
