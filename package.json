{
  "name": "veyrum-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm build && vitest run --maxWorkers=2",
    "check": "pnpm lint && pnpm build && pnpm test",
    "smoke:pack": "node scripts/pack-smoke.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.13.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
