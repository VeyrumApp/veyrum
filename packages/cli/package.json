{
  "name": "veyrum",
  "version": "0.1.0",
  "description": "Veyrum CLI: run only the tests whose evidence is no longer valid",
  "license": "Apache-2.0",
  "homepage": "https://github.com/VeyrumApp/veyrum#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VeyrumApp/veyrum.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=22.15"
  },
  "type": "module",
  "bin": {
    "veyrum": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "dependencies": {
    "@veyrum/core": "workspace:*",
    "@veyrum/jest": "workspace:*",
    "@veyrum/mocha": "workspace:*",
    "@veyrum/node-test": "workspace:*",
    "@veyrum/pytest": "workspace:*",
    "@veyrum/vitest": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
